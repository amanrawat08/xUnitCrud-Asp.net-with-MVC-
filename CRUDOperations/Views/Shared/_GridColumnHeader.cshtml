@if (ViewBag.CurrentSortBy == ViewBag.ColumnName &&
                ViewBag.CurrentSortOrder == nameof(SortOrderEnum.ASC).ToString())
{
    <th>
        <a
            href="~/persons/index?searchBy=@(ViewBag.CurrentSearchBy)&searchString=@(ViewBag.CurrentSearchString)&sortBy=@(ViewBag.CurrentSortBy)&sortOrder=@(nameof(SortOrderEnum.DESC))">
            @(ViewBag.DisplayName)
        </a>
        <i class="fa-solid fa-arrow-up"></i>
    </th>
}
else if (ViewBag.CurrentSortBy == ViewBag.ColumnName &&
ViewBag.CurrentSortOrder == nameof(SortOrderEnum.DESC).ToString())
{

    <th>
        <a
            href="~/persons/index?searchBy=@(ViewBag.CurrentSearchBy)&searchString=@(ViewBag.CurrentSearchString)&sortBy=@(ViewBag.ColumnName)&sortOrder=@(nameof(SortOrderEnum.ASC))">
            @(ViewBag.DisplayName)
        </a>
        <i class="fa-solid fa-arrow-down"></i>
    </th>
}
else
{

    <th>
        <a
            href="~/persons/index?searchBy=@(ViewBag.CurrentSearchBy)&searchString=@(ViewBag.CurrentSearchString)&sortBy=@(ViewBag.ColumnName)&sortOrder=@(nameof(SortOrderEnum.ASC))">
            @(ViewBag.DisplayName)
        </a>
    </th>
                        
}