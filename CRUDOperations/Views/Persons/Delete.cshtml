@model PersonResponse
@{
    ViewBag.Title = "Delete Person";
}

<a asp-controller="Persons" asp-action="Index"  class="link=hover">Back to Persons List</a>

<h2>Delete Persons</h2>

<div class="center-box">
    <form asp-controller="Persons" asp-action="Delete"  method="post">
        <input type="hidden" name="PersonID" asp-for="PersonID">
    @* PErsonName *@
    <div class="form-field flex">
        <div class="w-25 ">
            <label for="PersonName" class="form-label pt">Person Name</label>
        </div>
        <div class="flex-1">
            <input asp-for="PersonName" class="form-input" disabled />
            <span asp-validation-for="PersonName" class="text-red"></span>
        </div>
    </div>
    @* Email *@
    <div class="form-field flex">
        <div class="w-25 ">
            <label for="Email" class="form-label pt">Email</label>
        </div>
        <div class="flex-1">
            <input asp-for="Email" disabled  class="form-input"/>
            <span asp-validation-for="Email" class="text-red"></span>
        </div>
    </div>
  
    @* Submit Button *@
    <div class="form-field flex">
        <div class="w-25 ">
        </div>
        <div class="flex-1">
            <button type="submit" class="button button-red-back">Delete</button>
            <div asp-validation-summary="All" class="text-red"></div>

                    @if (ViewBag.Errors != null)
                    {   <div class="text-red ml">
                        <ul>
                        @foreach(var error in ViewBag.Errors)
                        {
                            <li class="ml">@error</li>
                        }
                        </ul>
                        </div>
                    } 
                </div>
    </div>



    
    </form>
</div>

 