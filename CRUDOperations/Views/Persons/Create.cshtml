@{
    ViewBag.Title = "Create Person";
}

<a href="~/persons/index" class="link=hover">Back to Persons List</a>

<h2>Create Persons</h2>

<div class="w-50">
    <form action="~/persons/create" method="post">
    @* PErsonName *@
    <div class="form-field flex">
        <div class="w-25 ">
            <label for="PersonName" class="form-label pt">Person Name</label>
        </div>
        <div class="flex-1">
            <input type="text" name="PersonName" id="PersonName" class="form-input"/>
        </div>
    </div>
    @* Email *@
    <div class="form-field flex">
        <div class="w-25 ">
            <label for="Email" class="form-label pt">Email</label>
        </div>
        <div class="flex-1">
            <input type="email" name="Email" id="Email" class="form-input"/>
        </div>
    </div>
    @* BirthOfDate *@
    <div class="form-field flex">
        <div class="w-25 ">
            <label for="BirthOfDate" class="form-label pt">Date Of Birth</label>
        </div>
        <div class="flex-1">
            <input type="date" name="BirthOfDate" id="BirthOfDate" class="form-input"/>
        </div>
    </div>
    @* Gender *@
    <div class="form-field flex">
        <div class="w-25 ">
            <label class="form-label ">Gender</label>
        </div>
        <div class="flex-1">
            <input type="radio" name="Gender" id="Male" value="Male" class="ml"/>
            <label for="Male">Male</label> &nbsp;
            <input type="radio" name="Gender" id="Female" value="Female" class="ml"/>
            <label for="Female">Female</label> &nbsp;
            <input type="radio" name="Gender" id="Other" value="Other" class="ml"/>
            <label for="Other">Other</label>
        </div>
    </div>
    @* Country *@
    <div class="form-field flex">
        <div class="w-25 ">
            <label class="form-label pt" for="CountryID">Country</label>
        </div>
        <div class="flex-1">
            <select name="CountryID" id="CountryID" class="form-input">
                <option value="">Please select</option>
                    @foreach(var country in ViewBag.Countries)
                        {
                            <option value="@country.CountryID">@country.CountryName</option>
                        }
            </select>
        </div>
    </div>
    @* Address *@
    <div class="form-field flex">
        <div class="w-25 ">
            <label for="Address" class="form-label pt">Address</label>
        </div>
        <div class="flex-1">
            <textarea  name="Address" id="Address" class="form-input"></textarea>
        </div>
    </div>
    @* RecieveNEWsLetter *@
    <div class="form-field flex">
        <div class="w-25 ">
        </div>
        <div class="flex-1">
            <input type="checkbox" name="RecieveNewsLetter" id="RecieveNewsLetter" value="true">
            <label for="RecieveNewsLetter" class="form-label pt">Recieve News Letter</label>
        </div>
    </div>
    @* Submit Button *@
    <div class="form-field flex">
        <div class="w-25 ">
        </div>
        <div class="flex-1">
            <button type="submit" class="button button-green-back">Create</button>

                    @if (ViewBag.Errors != null)
                    {   <div class="text-red ml">
                        <ul>
                        @foreach(var error in ViewBag.Errors)
                        {
                            <li class="ml">@error</li>
                        }
                        </ul>
                        </div>
                    } 
                </div>
    </div>



    
    </form>
</div>